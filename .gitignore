# ── AIPS QA 시스템(nipa_ai_eval) git 제외 목록 ──
# 실행 결과·상태 파일은 각자 PC에서 실행하면 새로 생기므로 저장소에 올리지 않습니다.

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 실행 결과 (QA 대시보드 / 규격서 시험 / 판단 여부 점검)
dashboard/
spec/
check/

# 실행 상태·로그·임시 파일
run_status.json
run_status.json.*.tmp
run_stop.flag
run.log
_variants_run.txt

# 엑셀로 열어 둔 파일이 만드는 잠금 파일
~$*

# OS
.DS_Store
Thumbs.db
desktop.ini

# 기준 문서 원본(규격서·시험의뢰서·수행계획서 PDF) — 기관 문서라 저장소(GitHub)에 올리지 않음. 서버 이관 압축 파일로만 옮김
참고문서/

# 법령·조례 조문 DB (약 42MB, tools/build_law_article_db.py 로 생성) — 서버에는 파일로 복사
spec_data/law_article_db.csv
# [DA 2] 온톨로지 인스턴스 (약 155MB, tools/export_ontology.py 로 Fuseki에서 내보냄) — 서버에는 파일로 복사
spec_data/da2/landcheck_instance_v1.0.ttl

# 중지된 실행 보관 (실행 결과와 같은 이유로 git 제외)
backup/중지된_실행/
# [DA 2] 법령 원문 조회 캐시
spec_data/da2/_law_cache/
# DA2 인스턴스 백업(155MB) — git 제외
backup/**/landcheck_instance_*.ttl
deploy/deploy_history.log
