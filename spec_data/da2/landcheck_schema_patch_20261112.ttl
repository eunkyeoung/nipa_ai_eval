# LandCheck 온톨로지 스키마 보완 패치 (2026-11-12, QA 작성 — 개발팀 검토·Fuseki 반영 대상)
# 목적: [DA 2-4] OOPS! 함정 중 Important 3종(P11·P34·P10) 해소. 기존 선언은 바꾸지 않고 '추가'만 함.
# 근거: 각 항목 주석. 인스턴스 데이터는 바꾸지 않음.
PREFIX aip:  <https://onto.go.kr/aip/>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# ── P11 속성의 domain 누락 (4개) ─────────────────────────────────────────
# hasUnit: 스키마 설명에 "(domain: Article·Appendix·ArticleUnit)"이 적혀 있으나 선언이 없었음.
#          인스턴스 사용도 같음(Article 109,250 · ArticleUnit 97,860 · Appendix 734).
aip:hasUnit rdfs:domain [ a owl:Class ; owl:unionOf ( aip:Article aip:Appendix aip:ArticleUnit ) ] .

# limitRelationCoverage · limitRelationOpenPairs: 설명 "그 조·별표 안 층수·높이 진술끼리의 관계" → 조·별표.
#          인스턴스 사용도 같음(Article 116 · Appendix 53).
aip:limitRelationCoverage  rdfs:domain [ a owl:Class ; owl:unionOf ( aip:Article aip:Appendix ) ] .
aip:limitRelationOpenPairs rdfs:domain [ a owl:Class ; owl:unionOf ( aip:Article aip:Appendix ) ] .

# appliesToActivity: 인스턴스 사용 0건. 설명 "이 관계가 적용되는 행위 코드 — 배제=제외 행위 …"에 따라
#          적용 배제 항목(Exemption)으로 둠. ※ 개발팀 확인 필요(의제·준용 관계 클래스가 생기면 넓혀야 함)
aip:appliesToActivity rdfs:domain aip:Exemption .

# ── P34 타입 없는 클래스 ─────────────────────────────────────────────────
# Zone·Sido 의 상위 클래스로 쓰이는 skos:Concept 을 클래스로 선언
skos:Concept a owl:Class ;
    rdfs:label "개념 (SKOS)"@ko , "Concept"@en ;
    rdfs:comment "SKOS 개념. 구역(Zone)·시도(Sido) 분류 체계의 상위 클래스."@ko .

# ── P10 서로소(disjoint) 선언 없음 ───────────────────────────────────────
# 핵심 클래스 9개는 서로 다른 종류의 대상. 인스턴스에 두 클래스를 함께 가진 노드 0건 확인(2026-11-12).
[] a owl:AllDisjointClasses ;
   owl:members ( aip:Law aip:Article aip:ArticleUnit aip:Appendix aip:Zone aip:Exemption
                 aip:LimitStatement aip:LimitCondition aip:Sido ) .
