# CQ-010 사유지에 건축법상 도로가 지정된 경우 그 도로에 접한 대지에서 건축할 수 있는가?
# 결과 ?ans 노드의 라벨을 '법령명.조.항'(호 제외)으로 정규화해 정답과 집합 비교
PREFIX aip: <https://onto.go.kr/aip/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?ans WHERE { { GRAPH ?g84 { ?L_d aip:lawName "건축법" . ?L_d aip:hasArticle ?d . ?d aip:articleTitle ?t_d . FILTER(CONTAINS(REPLACE(STR(?t_d), " ", ""), "정의")) } GRAPH ?g85 { ?d aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } GRAPH ?g86 { ?ans aip:hasUnit ?dh . } GRAPH ?g87 { ?dh aip:implementedBy ?di . } GRAPH ?g88 { ?di aip:articleTitle ?dit . FILTER(CONTAINS(STR(?dit), "도로")) } } UNION { GRAPH ?g89 { ?L_h aip:lawName "건축법" . ?L_h aip:hasArticle ?h . ?h aip:articleTitle ?t_h . FILTER(CONTAINS(REPLACE(STR(?t_h), " ", ""), "대지와도로의관계")) } GRAPH ?g90 { ?h aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } GRAPH ?g91 { ?ans aip:hasUnit ?hh . } GRAPH ?g92 { ?hh aip:implementedBy ?hl_ans . } } }
