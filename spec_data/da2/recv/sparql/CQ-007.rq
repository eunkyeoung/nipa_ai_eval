# CQ-007 이해관계인의 동의 없이 사실상의 통로를 건축법상 도로로 지정할 수 있는 경우는?
# 결과 ?ans 노드의 라벨을 '법령명.조.항'(호 제외)으로 정규화해 정답과 집합 비교
PREFIX aip: <https://onto.go.kr/aip/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?ans WHERE { { GRAPH ?g55 { ?L_h aip:lawName "건축법" . ?L_h aip:hasArticle ?h . ?h aip:articleTitle ?t_h . FILTER(CONTAINS(REPLACE(STR(?t_h), " ", ""), "도로의지정")) } GRAPH ?g56 { ?h aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } GRAPH ?g57 { ?ans aip:hasUnit ?hh . } GRAPH ?g58 { ?hh aip:implementedBy ?hl_ans . } GRAPH ?g54 { ?hl_ans ^aip:hasArticle/aip:lawName ?hln . FILTER(CONTAINS(?hln, "조례")) } } UNION { GRAPH ?g59 { ?L_d aip:lawName "건축법" . ?L_d aip:hasArticle ?d . ?d aip:articleTitle ?t_d . FILTER(CONTAINS(REPLACE(STR(?t_d), " ", ""), "정의")) } GRAPH ?g60 { ?d aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } GRAPH ?g61 { ?ans aip:hasUnit ?dh . } GRAPH ?g62 { ?dh aip:implementedBy ?di . } GRAPH ?g63 { ?di aip:articleTitle ?dit . FILTER(CONTAINS(STR(?dit), "도로")) } } }
