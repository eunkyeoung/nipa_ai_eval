# CQ-014 대지에 접한 통과 도로가 도로폭 미달일 경우 도로폭 확보 기준은?
# 결과 ?ans 노드의 라벨을 '법령명.조.항'(호 제외)으로 정규화해 정답과 집합 비교
PREFIX aip: <https://onto.go.kr/aip/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?ans WHERE { { GRAPH ?g119 { ?L_b aip:lawName "건축법" . ?L_b aip:hasArticle ?b . ?b aip:articleTitle ?t_b . FILTER(CONTAINS(REPLACE(STR(?t_b), " ", ""), "건축선의지정")) } GRAPH ?g120 { ?b aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } } UNION { GRAPH ?g121 { ?L_d aip:lawName "건축법" . ?L_d aip:hasArticle ?d . ?d aip:articleTitle ?t_d . FILTER(CONTAINS(REPLACE(STR(?t_d), " ", ""), "정의")) } GRAPH ?g122 { ?d aip:hasUnit ?ans . ?ans aip:unitType ?ut_ans . FILTER(STR(?ut_ans) = "항") } GRAPH ?g123 { ?ans aip:hasUnit ?dh . } GRAPH ?g124 { ?dh aip:implementedBy ?di . } GRAPH ?g125 { ?di aip:articleTitle ?dit . FILTER(CONTAINS(STR(?dit), "도로")) } } }
