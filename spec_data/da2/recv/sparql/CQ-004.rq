# CQ-004 한옥건축시 대지안의 공지 기준은?
# 결과 ?ans 노드의 라벨을 '법령명.조.항'(호 제외)으로 정규화해 정답과 집합 비교
PREFIX aip: <https://onto.go.kr/aip/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?ans WHERE { { { ?L_t aip:lawName "건축법" . ?L_t aip:hasArticle ?ans . ?ans aip:articleTitle ?t_t . FILTER(CONTAINS(REPLACE(STR(?t_t), " ", ""), "대지안의공지")) } } UNION { { ?L_u aip:lawName "건축법" . ?L_u aip:hasArticle ?u . ?u aip:articleTitle ?t_u . FILTER(CONTAINS(REPLACE(STR(?t_u), " ", ""), "대지안의공지")) } { ?u aip:implementedBy ?ans . } { ?ans aip:articleTitle ?at . FILTER(CONTAINS(REPLACE(STR(?at), " ", ""), "대지안의공지")) } } UNION { { ?L_t aip:lawName "음성군 건축 조례" . ?L_t aip:hasArticle ?ans . ?ans aip:articleTitle ?t_t . FILTER(CONTAINS(REPLACE(STR(?t_t), " ", ""), "대지안의공지")) } } UNION { { ?L_t aip:lawName "건축법" . ?L_t aip:hasArticle ?t . ?t aip:articleTitle ?t_t . FILTER(CONTAINS(REPLACE(STR(?t_t), " ", ""), "대지안의공지")) } { ?ans aip:relatedArticle ?t . } { ?ans a aip:Appendix . } } UNION { { ?L_u aip:lawName "건축법" . ?L_u aip:hasArticle ?u . ?u aip:articleTitle ?t_u . FILTER(CONTAINS(REPLACE(STR(?t_u), " ", ""), "대지안의공지")) } { ?u aip:implementedBy ?t . } { ?t aip:articleTitle ?at . FILTER(CONTAINS(REPLACE(STR(?at), " ", ""), "대지안의공지")) } { ?ans aip:relatedArticle ?t . } { ?ans a aip:Appendix . } } UNION { { ?L_t aip:lawName "음성군 건축 조례" . ?L_t aip:hasArticle ?t . ?t aip:articleTitle ?t_t . FILTER(CONTAINS(REPLACE(STR(?t_t), " ", ""), "대지안의공지")) } { ?ans aip:relatedArticle ?t . } { ?ans a aip:Appendix . } } }
