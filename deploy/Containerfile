# AIPS 사전진단 성능테스트 (QA) — podman 이미지
# 이미지에는 Python과 패키지만 넣고, 프로그램·시험 데이터·실행 결과는 서버 폴더(/opt/bi/nipa_ai_eval)를 /app 에 연결해서 씁니다.
# → 파일만 바꿔 넣으면 이미지를 다시 만들지 않아도 됩니다.
FROM docker.io/library/python:3.12-slim

ENV TZ=Asia/Seoul \
    LANG=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# PC에서 검증한 버전으로 고정
COPY deploy/requirements-lock.txt /tmp/requirements.txt
RUN pip install --root-user-action=ignore -r /tmp/requirements.txt && rm /tmp/requirements.txt

# [DA 2-4] OWL Reasoner(Pellet, owlready2 내장)용 Java — Eclipse Temurin JRE 25 (Pellet 내장 Jena가 Java 25 이상 필요)
RUN python -c "import urllib.request as u; r = u.urlopen(u.Request('https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jre/hotspot/normal/eclipse', headers={'User-Agent': 'curl/8.0'})); open('/tmp/jre.tgz', 'wb').write(r.read())"  && mkdir -p /opt/jre && tar -xzf /tmp/jre.tgz -C /opt/jre --strip-components=1 && rm /tmp/jre.tgz  && /opt/jre/bin/java -version
ENV PATH="/opt/jre/bin:${PATH}"

WORKDIR /app
EXPOSE 8501

# 컨테이너 안은 8501, 서버 포트(16850)는 실행할 때 -p 16850:8501 로 연결
CMD ["python", "-m", "streamlit", "run", "qa_app.py", \
     "--server.headless", "true", "--server.address", "0.0.0.0", "--server.port", "8501"]
